# ── Survey app (public, safe to expose to the browser) ──
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Admin panel (/admin) — SERVER ONLY, never prefix with NEXT_PUBLIC_ ──
# Supabase dashboard → Project Settings → API → service_role secret.
# Bypasses row-level security, which the admin panel needs because
# supabase/schema.sql grants anon INSERT only — no select policy at all.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Password for the entire /admin panel (HTTP Basic Auth, username "admin").
# Required — middleware.ts blocks /admin and /api/admin entirely if this is
# unset, rather than leaving them open. Pick something you're comfortable
# sharing only with your team, and set it in Vercel's Environment Variables
# for the deployed site (not just here).
ADMIN_PASSWORD=choose_a_strong_password
